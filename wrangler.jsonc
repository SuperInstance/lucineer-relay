{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lucineer-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "049ff5e84ecf636b53b162cbb580aae6",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lucineer-memory",
      "database_id": "9cf282f9-d171-43b6-9fa3-57c49122b0fe"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "LUCINEER_SESSION",
        "class_name": "LucineerSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LucineerSession"]
    }
  ],

  "ai": {
    "binding": "AI"
  },

  // Initialize D1 emotional memory schema on first deploy

  "r2_buckets": [
    {
      "binding": "LUCINEER_TRAJECTORIES",
      "bucket_name": "lucineer-trajectories"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // No vars needed — the push path was removed (it pointed at a WSL
  // private IP unreachable from Cloudflare Workers). The processor
  // polls /api/jobs/pending instead.
}
